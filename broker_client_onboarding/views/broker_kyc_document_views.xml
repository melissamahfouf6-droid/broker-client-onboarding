<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_broker_kyc_document_kanban" model="ir.ui.view">
        <field name="name">broker.kyc.document.kanban</field>
        <field name="model">broker.kyc.document</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="document_type"/>
                <field name="partner_id"/>
                <templates>
                    <t t-name="card">
                        <field name="partner_id" class="fw-bold"/>
                        <field name="document_type"/>
                        <field name="document_number"/>
                        <footer class="pt-1">
                            <field name="expiry_date"/>
                            <field name="reviewer_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_broker_kyc_document_list" model="ir.ui.view">
        <field name="name">broker.kyc.document.list</field>
        <field name="model">broker.kyc.document</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'approved'" decoration-warning="state == 'under_review'" decoration-danger="state == 'rejected'" decoration-info="state == 'submitted'" decoration-muted="state == 'expired'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="document_type"/>
                <field name="document_number"/>
                <field name="issue_date" optional="hide"/>
                <field name="expiry_date"/>
                <field name="reviewer_id" widget="many2one_avatar_user" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'under_review'"
                       decoration-danger="state == 'rejected'"
                       decoration-info="state == 'submitted'"
                       decoration-muted="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="view_broker_kyc_document_form" model="ir.ui.view">
        <field name="name">broker.kyc.document.form</field>
        <field name="model">broker.kyc.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_review" type="object" string="Start Review" class="btn-primary"
                            invisible="state != 'submitted'"
                            groups="broker_client_onboarding.group_broker_compliance"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'under_review'"
                            groups="broker_client_onboarding.group_broker_compliance"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'under_review'"
                            groups="broker_client_onboarding.group_broker_compliance"/>
                    <button name="action_reset_to_submitted" type="object" string="Reset to Submitted"
                            invisible="state == 'submitted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,under_review,approved"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-warning" invisible="state != 'expired'"/>
                    <div class="oe_title">
                        <label for="document_type"/>
                        <h1><field name="document_type" readonly="state != 'submitted'"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not is_uploader or state != 'under_review'">
                        You uploaded this document, so you cannot approve or reject it.
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'submitted'"/>
                            <field name="document_number" readonly="state != 'submitted'"/>
                            <field name="issue_date" readonly="state != 'submitted'"/>
                            <field name="expiry_date" readonly="state not in ('submitted', 'under_review')"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_uploader" invisible="1"/>
                        </group>
                        <group>
                            <field name="file" filename="file_name" readonly="state != 'submitted'"/>
                            <field name="file_name" invisible="1"/>
                            <field name="reviewer_id"/>
                            <field name="review_date"/>
                        </group>
                    </group>
                    <group invisible="state != 'rejected'" string="Rejection">
                        <field name="rejection_reason" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Approval Log" name="approval_log">
                            <field name="approval_log_ids" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="date"/>
                                    <field name="user_id"/>
                                    <field name="action"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_broker_kyc_document_search" model="ir.ui.view">
        <field name="name">broker.kyc.document.search</field>
        <field name="model">broker.kyc.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="document_number"/>
                <field name="reviewer_id"/>
                <filter string="Pending my review" name="pending_my_review"
                        domain="[('state', 'in', ('submitted', 'under_review')), ('create_uid', '!=', uid)]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Under Review" name="under_review" domain="[('state', '=', 'under_review')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter string="Identity" name="identity" domain="[('document_type', 'in', ('passport', 'national_id', 'driving_license'))]"/>
                <filter string="Proof of Address" name="address" domain="[('document_type', '=', 'proof_of_address')]"/>
                <separator/>
                <filter string="Expiring in 30 days" name="expiring_30"
                        domain="[('state', '=', 'approved'), ('expiry_date', '&gt;=', context_today().strftime('%Y-%m-%d')), ('expiry_date', '&lt;=', (context_today() + datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Document Type" name="group_type" context="{'group_by': 'document_type'}"/>
                    <filter string="Client" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Reviewer" name="group_reviewer" context="{'group_by': 'reviewer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_broker_kyc_document" model="ir.actions.act_window">
        <field name="name">KYC Documents</field>
        <field name="res_model">broker.kyc.document</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a KYC document</p>
            <p>A client is approved only when an identity document and a proof of address are both approved and still in date.</p>
        </field>
    </record>
</odoo>
