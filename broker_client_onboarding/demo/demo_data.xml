<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="commission_plan_standard" model="broker.commission.plan">
        <field name="name">Standard IB 8%</field>
        <field name="commission_type">percent_of_deposit</field>
        <field name="rate">8</field>
    </record>
    <record id="commission_plan_volume" model="broker.commission.plan">
        <field name="name">Pro Volume, 7 per lot</field>
        <field name="commission_type">per_lot</field>
        <field name="rate">7</field>
    </record>

    <record id="partner_ib_horizon" model="res.partner">
        <field name="name">Horizon Bridge Ltd</field>
        <field name="is_company" eval="True"/>
        <field name="is_introducing_broker" eval="True"/>
        <field name="email">partners@horizonbridge.example</field>
        <field name="country_id" ref="base.cy"/>
        <field name="city">Limassol</field>
        <field name="commission_plan_id" ref="commission_plan_standard"/>
    </record>

    <record id="partner_amina" model="res.partner">
        <field name="name">Amina El-Sayed</field>
        <field name="is_trader" eval="True"/>
        <field name="email">amina.elsayed@example.com</field>
        <field name="phone">+971500000001</field>
        <field name="country_id" ref="base.ae"/>
        <field name="city">Dubai</field>
        <field name="risk_level_id" ref="risk_level_low"/>
        <field name="introducing_broker_id" ref="partner_ib_horizon"/>
    </record>
    <record id="partner_jonas" model="res.partner">
        <field name="name">Jonas Meier</field>
        <field name="is_trader" eval="True"/>
        <field name="email">jonas.meier@example.com</field>
        <field name="country_id" ref="base.de"/>
        <field name="city">Berlin</field>
        <field name="risk_level_id" ref="risk_level_medium"/>
        <field name="introducing_broker_id" ref="partner_ib_horizon"/>
    </record>
    <record id="partner_chloe" model="res.partner">
        <field name="name">Chloe Martin</field>
        <field name="is_trader" eval="True"/>
        <field name="email">chloe.martin@example.com</field>
        <field name="country_id" ref="base.fr"/>
        <field name="city">Lyon</field>
        <field name="risk_level_id" ref="risk_level_high"/>
    </record>

    <record id="doc_amina_passport" model="broker.kyc.document">
        <field name="partner_id" ref="partner_amina"/>
        <field name="document_type">passport</field>
        <field name="file" type="base64" file="broker_client_onboarding/demo/files/kyc_sample.png"/>
        <field name="file_name">amina-passport.png</field>
        <field name="document_number">P8842117</field>
        <field name="issue_date" eval="(datetime.now() - relativedelta(years=2)).date()"/>
        <field name="expiry_date" eval="(datetime.now() + relativedelta(years=5)).date()"/>
        <field name="state">approved</field>
        <field name="reviewer_id" ref="base.user_admin"/>
        <field name="review_date" eval="datetime.now() - relativedelta(days=3)"/>
    </record>
    <record id="doc_amina_address" model="broker.kyc.document">
        <field name="partner_id" ref="partner_amina"/>
        <field name="document_type">proof_of_address</field>
        <field name="file" type="base64" file="broker_client_onboarding/demo/files/kyc_sample.png"/>
        <field name="file_name">amina-utility-bill.png</field>
        <field name="document_number">DEWA-20441</field>
        <field name="issue_date" eval="(datetime.now() - relativedelta(days=20)).date()"/>
        <field name="expiry_date" eval="(datetime.now() + relativedelta(days=70)).date()"/>
        <field name="state">approved</field>
        <field name="reviewer_id" ref="base.user_admin"/>
        <field name="review_date" eval="datetime.now() - relativedelta(days=2)"/>
    </record>
    <record id="doc_jonas_passport" model="broker.kyc.document">
        <field name="partner_id" ref="partner_jonas"/>
        <field name="document_type">passport</field>
        <field name="file" type="base64" file="broker_client_onboarding/demo/files/kyc_sample.png"/>
        <field name="file_name">jonas-passport.png</field>
        <field name="document_number">C01X9K2P4</field>
        <field name="issue_date" eval="(datetime.now() - relativedelta(years=1)).date()"/>
        <field name="expiry_date" eval="(datetime.now() + relativedelta(years=8)).date()"/>
        <field name="state">under_review</field>
    </record>
    <record id="doc_jonas_address" model="broker.kyc.document">
        <field name="partner_id" ref="partner_jonas"/>
        <field name="document_type">proof_of_address</field>
        <field name="file" type="base64" file="broker_client_onboarding/demo/files/kyc_sample.png"/>
        <field name="file_name">jonas-bank-statement.png</field>
        <field name="document_number">STMT-33910</field>
        <field name="issue_date" eval="(datetime.now() - relativedelta(days=12)).date()"/>
        <field name="expiry_date" eval="(datetime.now() + relativedelta(days=78)).date()"/>
        <field name="state">submitted</field>
    </record>
    <record id="doc_chloe_id" model="broker.kyc.document">
        <field name="partner_id" ref="partner_chloe"/>
        <field name="document_type">national_id</field>
        <field name="file" type="base64" file="broker_client_onboarding/demo/files/kyc_sample.png"/>
        <field name="file_name">chloe-national-id.png</field>
        <field name="document_number">FR-992013</field>
        <field name="issue_date" eval="(datetime.now() - relativedelta(years=4)).date()"/>
        <field name="expiry_date" eval="(datetime.now() + relativedelta(years=6)).date()"/>
        <field name="state">rejected</field>
        <field name="rejection_reason">The scan is cropped and the MRZ cannot be read. Ask for a full-page colour scan.</field>
        <field name="reviewer_id" ref="base.user_admin"/>
        <field name="review_date" eval="datetime.now() - relativedelta(days=1)"/>
    </record>

    <record id="account_amina_live" model="broker.trading.account">
        <field name="partner_id" ref="partner_amina"/>
        <field name="account_type">live</field>
        <field name="leverage">100</field>
        <field name="state">active</field>
    </record>
    <record id="account_amina_demo" model="broker.trading.account">
        <field name="partner_id" ref="partner_amina"/>
        <field name="account_type">demo</field>
        <field name="leverage">500</field>
        <field name="state">active</field>
    </record>
    <record id="account_jonas_live" model="broker.trading.account">
        <field name="partner_id" ref="partner_jonas"/>
        <field name="account_type">live</field>
        <field name="leverage">50</field>
        <field name="state">draft</field>
    </record>
    <record id="account_chloe_demo" model="broker.trading.account">
        <field name="partner_id" ref="partner_chloe"/>
        <field name="account_type">demo</field>
        <field name="leverage">20</field>
        <field name="state">active</field>
    </record>

    <record id="tx_amina_deposit_done" model="broker.transaction">
        <field name="transaction_type">deposit</field>
        <field name="account_id" ref="account_amina_live"/>
        <field name="amount">8000</field>
        <field name="payment_method">bank_transfer</field>
        <field name="reference">ENBD-884211</field>
        <field name="state">done</field>
        <field name="submitted_date" eval="(datetime.now() - relativedelta(days=1)).date()"/>
        <field name="requested_by" ref="base.user_admin"/>
    </record>
    <record id="tx_amina_deposit_pending" model="broker.transaction">
        <field name="transaction_type">deposit</field>
        <field name="account_id" ref="account_amina_live"/>
        <field name="amount">12000</field>
        <field name="payment_method">card</field>
        <field name="reference">CARD-44190</field>
        <field name="state">to_approve</field>
        <field name="submitted_date" eval="datetime.now().date()"/>
        <field name="requested_by" ref="base.user_admin"/>
    </record>
    <record id="tx_amina_withdrawal_draft" model="broker.transaction">
        <field name="transaction_type">withdrawal</field>
        <field name="account_id" ref="account_amina_live"/>
        <field name="amount">500</field>
        <field name="payment_method">bank_transfer</field>
        <field name="reference">WDR-DRAFT</field>
        <field name="state">draft</field>
        <field name="requested_by" ref="base.user_admin"/>
    </record>

    <record id="trade_amina_eurusd" model="broker.trade">
        <field name="account_id" ref="account_amina_live"/>
        <field name="symbol">EURUSD</field>
        <field name="volume_lots">1.20</field>
        <field name="open_datetime" eval="datetime.now() - relativedelta(days=1, hours=4)"/>
        <field name="close_datetime" eval="datetime.now() - relativedelta(hours=6)"/>
    </record>

    <record id="log_amina_passport" model="broker.approval.log">
        <field name="res_model">broker.kyc.document</field>
        <field name="res_id" eval="ref('doc_amina_passport')"/>
        <field name="kyc_document_id" ref="doc_amina_passport"/>
        <field name="action">approve</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="comment">Passport chip and photo match the application.</field>
    </record>
    <record id="log_amina_address" model="broker.approval.log">
        <field name="res_model">broker.kyc.document</field>
        <field name="res_id" eval="ref('doc_amina_address')"/>
        <field name="kyc_document_id" ref="doc_amina_address"/>
        <field name="action">approve</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="comment">Utility bill is under 90 days and the address matches.</field>
    </record>
    <record id="log_amina_deposit_submit" model="broker.approval.log">
        <field name="res_model">broker.transaction</field>
        <field name="res_id" eval="ref('tx_amina_deposit_done')"/>
        <field name="transaction_id" ref="tx_amina_deposit_done"/>
        <field name="action">submit</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="amount">8000</field>
    </record>
    <record id="log_amina_deposit_approve" model="broker.approval.log">
        <field name="res_model">broker.transaction</field>
        <field name="res_id" eval="ref('tx_amina_deposit_done')"/>
        <field name="transaction_id" ref="tx_amina_deposit_done"/>
        <field name="action">approve</field>
        <field name="level">1</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="amount">8000</field>
        <field name="comment">Under the second-approval threshold. One compliance approval is enough.</field>
    </record>
    <record id="log_amina_deposit_done" model="broker.approval.log">
        <field name="res_model">broker.transaction</field>
        <field name="res_id" eval="ref('tx_amina_deposit_done')"/>
        <field name="transaction_id" ref="tx_amina_deposit_done"/>
        <field name="action">done</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="amount">8000</field>
    </record>
    <record id="log_chloe_reject" model="broker.approval.log">
        <field name="res_model">broker.kyc.document</field>
        <field name="res_id" eval="ref('doc_chloe_id')"/>
        <field name="kyc_document_id" ref="doc_chloe_id"/>
        <field name="action">reject</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="comment">The scan is cropped and the MRZ cannot be read. Ask for a full-page colour scan.</field>
    </record>
</odoo>
