<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_broker_trading_account_list" model="ir.ui.view">
        <field name="name">broker.trading.account.list</field>
        <field name="model">broker.trading.account</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'" decoration-warning="state == 'suspended'" decoration-muted="state in ('draft', 'closed')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="account_type"/>
                <field name="leverage"/>
                <field name="risk_level_id"/>
                <field name="balance"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="partner_kyc_status" widget="badge" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'suspended'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state == 'closed'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_broker_trading_account_form" model="ir.ui.view">
        <field name="name">broker.trading.account.form</field>
        <field name="model">broker.trading.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary"
                            invisible="state not in ('draft', 'suspended')"/>
                    <button name="action_suspend" type="object" string="Suspend"
                            invisible="state != 'active'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state == 'closed'" confirm="Close this account? A live account with a balance cannot be closed."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,suspended,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_transactions" type="object" class="oe_stat_button" icon="fa-exchange">
                            <field name="transaction_count" widget="statinfo" string="Transactions"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Suspended" bg_color="text-bg-warning" invisible="state != 'suspended'"/>
                    <widget name="web_ribbon" title="Closed" bg_color="text-bg-danger" invisible="state != 'closed'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <h2>
                            <field name="balance" widget="monetary"/>
                        </h2>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="account_type != 'live' or partner_kyc_status == 'approved'">
                        This live account cannot be activated until the client's KYC is approved.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="account_type != 'demo'">
                        A demo account never accepts a real deposit or withdrawal.
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="partner_kyc_status" widget="badge"
                                   decoration-success="partner_kyc_status == 'approved'"
                                   decoration-warning="partner_kyc_status == 'pending'"
                                   decoration-danger="partner_kyc_status in ('rejected', 'expired')"/>
                            <field name="account_type" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="risk_level_id"/>
                            <field name="leverage"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Margin call notes, professional-client classification, anything the dealing desk should see."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_broker_trading_account_search" model="ir.ui.view">
        <field name="name">broker.trading.account.search</field>
        <field name="model">broker.trading.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="risk_level_id"/>
                <filter string="Live" name="live" domain="[('account_type', '=', 'live')]"/>
                <filter string="Demo" name="demo" domain="[('account_type', '=', 'demo')]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Suspended" name="suspended" domain="[('state', '=', 'suspended')]"/>
                <filter string="Closed" name="closed" domain="[('state', '=', 'closed')]"/>
                <group>
                    <filter string="Client" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'account_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Risk Level" name="group_risk" context="{'group_by': 'risk_level_id'}"/>
                    <filter string="Currency" name="group_currency" context="{'group_by': 'currency_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_broker_trading_account" model="ir.actions.act_window">
        <field name="name">Trading Accounts</field>
        <field name="res_model">broker.trading.account</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_live': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Open a trading account</p>
            <p>Demo accounts can be used immediately. A live account stays in draft until the client's KYC is approved.</p>
        </field>
    </record>
</odoo>
