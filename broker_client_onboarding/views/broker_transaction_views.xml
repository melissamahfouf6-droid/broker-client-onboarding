<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_broker_transaction_list" model="ir.ui.view">
        <field name="name">broker.transaction.list</field>
        <field name="model">broker.transaction</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-warning="state == 'to_approve'" decoration-info="state == 'approved'" decoration-danger="state == 'rejected'" decoration-muted="state in ('draft', 'cancelled')">
                <field name="name"/>
                <field name="transaction_type"/>
                <field name="partner_id"/>
                <field name="account_id"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="payment_method" optional="show"/>
                <field name="required_approvals" optional="show"/>
                <field name="approval_count" optional="show"/>
                <field name="requested_by" widget="many2one_avatar_user" optional="hide"/>
                <field name="submitted_date" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'to_approve'"
                       decoration-info="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state in ('draft', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="view_broker_transaction_form" model="ir.ui.view">
        <field name="name">broker.transaction.form</field>
        <field name="model">broker.transaction</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'to_approve'"
                            groups="broker_client_onboarding.group_broker_compliance"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'to_approve'"
                            groups="broker_client_onboarding.group_broker_compliance"/>
                    <button name="action_mark_done" type="object" string="Mark as Done" class="btn-primary"
                            invisible="state != 'approved'"
                            groups="broker_client_onboarding.group_broker_finance"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'to_approve', 'approved')"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('rejected', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_approve,approved,done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary" invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="transaction_type" readonly="state != 'draft'"/>
                            <field name="account_id" readonly="state != 'draft'"/>
                            <field name="partner_id"/>
                            <field name="partner_kyc_status" widget="badge"
                                   decoration-success="partner_kyc_status == 'approved'"
                                   decoration-danger="partner_kyc_status in ('rejected', 'expired', 'not_started')"
                                   decoration-warning="partner_kyc_status == 'pending'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="payment_method" readonly="state != 'draft'"/>
                            <field name="reference" readonly="state not in ('draft', 'to_approve')"/>
                        </group>
                        <group string="Limits and approvals">
                            <field name="risk_level_id"/>
                            <field name="limit_currency_id" invisible="1"/>
                            <field name="max_single_deposit" invisible="transaction_type != 'deposit'"/>
                            <field name="max_single_withdrawal" invisible="transaction_type != 'withdrawal'"/>
                            <field name="daily_withdrawal_limit" invisible="transaction_type != 'withdrawal'"/>
                            <field name="available_to_withdraw" invisible="transaction_type != 'withdrawal'"/>
                            <field name="second_approval_threshold"/>
                            <field name="required_approvals"/>
                            <field name="approval_count"/>
                            <field name="requested_by"/>
                            <field name="submitted_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approval Log" name="approval_log">
                            <field name="approval_log_ids" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="date"/>
                                    <field name="user_id"/>
                                    <field name="action"/>
                                    <field name="level"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_broker_transaction_search" model="ir.ui.view">
        <field name="name">broker.transaction.search</field>
        <field name="model">broker.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="account_id"/>
                <field name="reference"/>
                <filter string="To Approve" name="to_approve" domain="[('state', '=', 'to_approve')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="My Requests" name="my_requests" domain="[('requested_by', '=', uid)]"/>
                <separator/>
                <filter string="Deposits" name="deposits" domain="[('transaction_type', '=', 'deposit')]"/>
                <filter string="Withdrawals" name="withdrawals" domain="[('transaction_type', '=', 'withdrawal')]"/>
                <group>
                    <filter string="Type" name="group_type" context="{'group_by': 'transaction_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Client" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Account" name="group_account" context="{'group_by': 'account_id'}"/>
                    <filter string="Payment Method" name="group_method" context="{'group_by': 'payment_method'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_broker_transaction" model="ir.actions.act_window">
        <field name="name">Deposits &amp; Withdrawals</field>
        <field name="res_model">broker.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_approve': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a deposit or a withdrawal</p>
            <p>The account must be a live, active account and the client's KYC must be approved. Amounts above the risk threshold need two approvals.</p>
        </field>
    </record>
</odoo>
