<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_broker_commission_plan_list" model="ir.ui.view">
        <field name="name">broker.commission.plan.list</field>
        <field name="model">broker.commission.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="commission_type"/>
                <field name="rate"/>
                <field name="currency_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_broker_commission_plan_form" model="ir.ui.view">
        <field name="name">broker.commission.plan.form</field>
        <field name="model">broker.commission.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Standard IB 8%"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="commission_type"/>
                            <field name="rate"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="commission_type != 'percent_of_deposit'">
                        Accrued when a referred client's deposit is marked done. A rate of 8 is eight percent of that deposit.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="commission_type != 'per_lot'">
                        Accrued when a trade is booked on a referred client's live account. The rate is the amount paid for each lot.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_broker_commission_plan_search" model="ir.ui.view">
        <field name="name">broker.commission.plan.search</field>
        <field name="model">broker.commission.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Per Lot" name="per_lot" domain="[('commission_type', '=', 'per_lot')]"/>
                <filter string="Percent of Deposit" name="percent" domain="[('commission_type', '=', 'percent_of_deposit')]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Type" name="group_type" context="{'group_by': 'commission_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_broker_commission_plan" model="ir.actions.act_window">
        <field name="name">Commission Plans</field>
        <field name="res_model">broker.commission.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_broker_ib_commission_list" model="ir.ui.view">
        <field name="name">broker.ib.commission.list</field>
        <field name="model">broker.ib.commission</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'pending'" decoration-info="state == 'confirmed'" decoration-success="state == 'paid'">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            groups="broker_client_onboarding.group_broker_finance"/>
                    <button name="action_mark_paid" type="object" string="Mark Paid"
                            groups="broker_client_onboarding.group_broker_finance"/>
                </header>
                <field name="name"/>
                <field name="ib_partner_id"/>
                <field name="client_partner_id"/>
                <field name="source_transaction_id" optional="show"/>
                <field name="source_trade_id" optional="show"/>
                <field name="base_amount"/>
                <field name="rate"/>
                <field name="commission_amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'pending'"
                       decoration-info="state == 'confirmed'"
                       decoration-success="state == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="view_broker_ib_commission_form" model="ir.ui.view">
        <field name="name">broker.ib.commission.form</field>
        <field name="model">broker.ib.commission</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            invisible="state != 'pending'"
                            groups="broker_client_onboarding.group_broker_finance"/>
                    <button name="action_mark_paid" type="object" string="Mark Paid" class="btn-primary"
                            invisible="state != 'confirmed'"
                            groups="broker_client_onboarding.group_broker_finance"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,confirmed,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="ib_partner_id" readonly="state != 'pending'"/>
                            <field name="client_partner_id" readonly="state != 'pending'"/>
                            <field name="plan_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="source_transaction_id"/>
                            <field name="source_trade_id"/>
                            <field name="base_amount"/>
                            <field name="rate"/>
                            <field name="commission_amount"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_broker_ib_commission_search" model="ir.ui.view">
        <field name="name">broker.ib.commission.search</field>
        <field name="model">broker.ib.commission</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="ib_partner_id"/>
                <field name="client_partner_id"/>
                <field name="source_transaction_id"/>
                <field name="source_trade_id"/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                <group>
                    <filter string="Introducing Broker" name="group_ib" context="{'group_by': 'ib_partner_id'}"/>
                    <filter string="Client" name="group_client" context="{'group_by': 'client_partner_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Plan" name="group_plan" context="{'group_by': 'plan_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_broker_ib_commission" model="ir.actions.act_window">
        <field name="name">IB Commissions</field>
        <field name="res_model">broker.ib.commission</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No commission has been accrued yet</p>
            <p>Commission is created when a referred deposit is paid, or when a live trade is booked for a per-lot plan.</p>
        </field>
    </record>
</odoo>
