<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_broker_transaction_reject_wizard_form" model="ir.ui.view">
        <field name="name">broker.transaction.reject.wizard.form</field>
        <field name="model">broker.transaction.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Funding Request">
                <group>
                    <field name="transaction_id" readonly="1"/>
                    <field name="rejection_reason" placeholder="For example: the source of funds does not match the client's profile."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reject Request" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
