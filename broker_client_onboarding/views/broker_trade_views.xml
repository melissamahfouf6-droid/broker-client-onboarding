<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_broker_trade_list" model="ir.ui.view">
        <field name="name">broker.trade.list</field>
        <field name="model">broker.trade</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="symbol"/>
                <field name="volume_lots"/>
                <field name="open_datetime"/>
                <field name="close_datetime"/>
            </list>
        </field>
    </record>

    <record id="view_broker_trade_form" model="ir.ui.view">
        <field name="name">broker.trade.form</field>
        <field name="model">broker.trade</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert">
                        This ticket stands in for a fill synced from MT4 or MT5. A per-lot introducing broker is paid when the ticket is on a live account.
                    </div>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="partner_id"/>
                            <field name="symbol"/>
                            <field name="volume_lots"/>
                        </group>
                        <group>
                            <field name="open_datetime"/>
                            <field name="close_datetime"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="IB Commission" name="commission">
                            <field name="commission_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="ib_partner_id"/>
                                    <field name="base_amount"/>
                                    <field name="rate"/>
                                    <field name="commission_amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_broker_trade_search" model="ir.ui.view">
        <field name="name">broker.trade.search</field>
        <field name="model">broker.trade</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="symbol"/>
                <field name="account_id"/>
                <field name="partner_id"/>
                <filter string="Open" name="open" domain="[('close_datetime', '=', False)]"/>
                <filter string="Closed" name="closed" domain="[('close_datetime', '!=', False)]"/>
                <group>
                    <filter string="Symbol" name="group_symbol" context="{'group_by': 'symbol'}"/>
                    <filter string="Account" name="group_account" context="{'group_by': 'account_id'}"/>
                    <filter string="Client" name="group_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_broker_trade" model="ir.actions.act_window">
        <field name="name">Trades</field>
        <field name="res_model">broker.trade</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Book a trade</p>
            <p>Volume on a live account accrues per-lot commission for the client's introducing broker.</p>
        </field>
    </record>
</odoo>
