<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_broker_kyc_reject_wizard_form" model="ir.ui.view">
        <field name="name">broker.kyc.reject.wizard.form</field>
        <field name="model">broker.kyc.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject KYC Document">
                <group>
                    <field name="document_id" readonly="1"/>
                    <field name="rejection_reason" placeholder="For example: the photo is cropped and the MRZ cannot be read. Ask the client for a new scan."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reject Document" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
